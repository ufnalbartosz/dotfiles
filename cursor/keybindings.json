// Place your key bindings in this file to override the defaults
[
    {
        "key": "cmd+i",
        "command": "composerMode.agent"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+x m",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    {
        "key": "alt+cmd+s",
        "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
        "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
    },
    // Terminal management (ctrl+x chords, terminal-scoped)
    {
        "key": "ctrl+x ctrl+c",
        "command": "workbench.action.terminal.new",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+x ctrl+k",
        "command": "workbench.action.terminal.kill",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+x up",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+x down",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    // Toggle focus between editor and terminal
    {
        "key": "cmd+\\",
        "command": "workbench.action.terminal.focus",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+\\",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+\\",
        "command": "-workbench.action.terminal.split",
        "when": "terminalFocus"
    },
    {
        "key": "cmd+\\",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "explorerViewletFocus"
    },
    {
        "key": "ctrl+x ctrl+z",
        "command": "workbench.action.toggleZenMode"
    },
    {
        "key": "ctrl+x ctrl+g",
        "command": "gitlens.showGraphView"
    },
    {
        "key": "ctrl+x ctrl+e",
        "command": "workbench.view.explorer"
    },
    {
        "key": "ctrl+x ctrl+t",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "ctrl+x ctrl+s",
        "command": "workbench.action.files.save",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+x s",
        "command": "workbench.action.findInFiles"
    },
    {
        "key": "ctrl+x o",
        "command": "workbench.action.focusFirstEditorGroup",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+x o",
        "command": "workbench.action.focusNextGroup",
        "when": "editorTextFocus && multipleEditorGroups && !activeEditorGroupLast"
    },
    {
        "key": "ctrl+x o",
        "command": "workbench.action.terminal.focus",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+x o",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "explorerViewletFocus"
    },
    {
        "key": "ctrl+x ctrl+i",
        "command": "editor.action.indentLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Move lines up/down
    {
        "key": "alt+shift+p",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+shift+n",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    // --- New bindings below ---
    {
        "key": "ctrl+x ctrl+p",
        "command": "test-navigator.jumpTest",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+.",
        "command": "editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "ctrl+x ctrl+shift+p",
        "command": "test-navigator.createTest",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+,",
        "command": "-workbench.action.openSettings"
    },
    {
        "key": "cmd+,",
        "command": "workbench.action.navigateBack"
    },
    {
        "key": "cmd+/",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+m",
        "command": "-editor.action.toggleTabFocusMode"
    },
    {
        "key": "cmd+j",
        "command": "workbench.action.togglePanel"
    },
    {
        "key": "cmd+j",
        "command": "-workbench.action.chat.toggleAgentMode"
    },
    {
        "key": "escape",
        "command": "workbench.action.chat.stopInChatSession",
        "when": "inChat"
    },
    // --- Emacs keys without the emacs-mcx extension (editor only) ---
    // Char/line movement and deletion (macOS has most of these natively; explicit so they hold everywhere)
    { "key": "ctrl+a", "command": "cursorHome", "when": "editorTextFocus" },
    { "key": "ctrl+e", "command": "cursorEnd", "when": "editorTextFocus" },
    { "key": "ctrl+f", "command": "cursorRight", "when": "editorTextFocus" },
    { "key": "ctrl+b", "command": "cursorLeft", "when": "editorTextFocus" },
    { "key": "ctrl+n", "command": "cursorDown", "when": "editorTextFocus && !suggestWidgetVisible" },
    { "key": "ctrl+p", "command": "cursorUp", "when": "editorTextFocus && !suggestWidgetVisible" },
    { "key": "ctrl+d", "command": "deleteRight", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+h", "command": "deleteLeft", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+k", "command": "deleteAllRight", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+t", "command": "editor.action.transposeLetters", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+o", "command": "lineBreakInsert", "when": "editorTextFocus && !editorReadonly" },
    // Words (Option = Meta)
    { "key": "alt+f", "command": "cursorWordEndRight", "when": "editorTextFocus" },
    { "key": "alt+b", "command": "cursorWordStartLeft", "when": "editorTextFocus" },
    { "key": "alt+d", "command": "deleteWordRight", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+backspace", "command": "deleteWordLeft", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+m", "command": "cursorHome", "when": "editorTextFocus" },
    { "key": "alt+shift+6", "command": "editor.action.joinLines", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+u", "command": "editor.action.transformToUppercase", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+l", "command": "editor.action.transformToLowercase", "when": "editorTextFocus && !editorReadonly" },
    { "key": "alt+c", "command": "editor.action.transformToTitlecase", "when": "editorTextFocus && !editorReadonly" },
    // Buffer / page / paragraph
    { "key": "alt+shift+,", "command": "cursorTop", "when": "editorTextFocus" },
    { "key": "alt+shift+.", "command": "cursorBottom", "when": "editorTextFocus" },
    { "key": "ctrl+v", "command": "cursorPageDown", "when": "editorTextFocus" },
    { "key": "alt+v", "command": "cursorPageUp", "when": "editorTextFocus" },
    { "key": "alt+g g", "command": "workbench.action.gotoLine" },
    { "key": "alt+.", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus" },
    // Search: C-s / C-r open find, then step through matches; C-g / Esc closes it
    { "key": "ctrl+s", "command": "actions.find", "when": "editorFocus && !findWidgetVisible" },
    { "key": "ctrl+s", "command": "editor.action.nextMatchFindAction", "when": "editorFocus && findWidgetVisible" },
    { "key": "ctrl+r", "command": "actions.find", "when": "editorFocus && !findWidgetVisible" },
    { "key": "ctrl+r", "command": "editor.action.previousMatchFindAction", "when": "editorFocus && findWidgetVisible" },
    { "key": "alt+shift+5", "command": "editor.action.startFindReplace", "when": "editorFocus" },
    // Cancel (C-g)
    { "key": "ctrl+g", "command": "closeFindWidget", "when": "findWidgetVisible" },
    { "key": "ctrl+g", "command": "removeSecondaryCursors", "when": "editorHasMultipleSelections && textInputFocus" },
    { "key": "ctrl+g", "command": "cancelSelection", "when": "editorHasSelection && textInputFocus" },
    { "key": "ctrl+g", "command": "workbench.action.closeQuickOpen", "when": "inQuickOpen" },
    // Kill/yank through the system clipboard (no kill ring)
    { "key": "ctrl+w", "command": "runCommands", "args": { "commands": ["editor.action.clipboardCutAction", { "command": "_setContext", "args": ["emacsMark", false] }] }, "when": "editorTextFocus && editorHasSelection && !editorReadonly" },
    { "key": "alt+w", "command": "runCommands", "args": { "commands": ["editor.action.clipboardCopyAction", "cancelSelection", { "command": "_setContext", "args": ["emacsMark", false] }] }, "when": "editorTextFocus && editorHasSelection" },
    { "key": "ctrl+y", "command": "editor.action.clipboardPasteAction", "when": "editorTextFocus && !editorReadonly" },
    // Undo and select-all
    { "key": "ctrl+/", "command": "undo", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+x u", "command": "undo", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+x h", "command": "editor.action.selectAll", "when": "editorTextFocus" },
    // Region case (C-x C-u / C-x C-l)
    { "key": "ctrl+x ctrl+u", "command": "editor.action.transformToUppercase", "when": "editorTextFocus && !editorReadonly" },
    { "key": "ctrl+x ctrl+l", "command": "editor.action.transformToLowercase", "when": "editorTextFocus && !editorReadonly" },
    // Mark mode (C-Space / C-@): sets the emacsMark context; movement keys then extend the selection.
    // C-g, Esc, C-w and M-w end it. Must stay after the plain movement bindings (last match wins).
    { "key": "ctrl+space", "command": "_setContext", "args": ["emacsMark", true], "when": "editorTextFocus && !emacsMark" },
    { "key": "ctrl+shift+2", "command": "_setContext", "args": ["emacsMark", true], "when": "editorTextFocus && !emacsMark" },
    { "key": "ctrl+space", "command": "cancelSelection", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+shift+2", "command": "cancelSelection", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+f", "command": "cursorRightSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+b", "command": "cursorLeftSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+n", "command": "cursorDownSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+p", "command": "cursorUpSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+a", "command": "cursorHomeSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+e", "command": "cursorEndSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "alt+f", "command": "cursorWordEndRightSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "alt+b", "command": "cursorWordStartLeftSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "alt+shift+,", "command": "cursorTopSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "alt+shift+.", "command": "cursorBottomSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+v", "command": "cursorPageDownSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "alt+v", "command": "cursorPageUpSelect", "when": "editorTextFocus && emacsMark" },
    { "key": "ctrl+g", "command": "runCommands", "args": { "commands": ["cancelSelection", { "command": "_setContext", "args": ["emacsMark", false] }] }, "when": "textInputFocus && emacsMark" },
    { "key": "escape", "command": "runCommands", "args": { "commands": ["cancelSelection", { "command": "_setContext", "args": ["emacsMark", false] }] }, "when": "textInputFocus && emacsMark" }
]
